# Copy this file to .env and fill in. .env is git-ignored - never commit it.

# --- Meta (Facebook) Marketing API + Conversions API ---
# Token: Business Manager -> System Users -> Generate token
#   scopes: ads_read (pull spend), ads_management (CAPI)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_XXXXXXXXXXXX     # include the "act_" prefix
META_PIXEL_ID=                          # the dataset / pixel the CAPI events go to
META_API_VERSION=v23.0                  # check developers.facebook.com for the current version
META_TEST_EVENT_CODE=                   # optional: from Events Manager > Test Events, for safe testing
